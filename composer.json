{
    "name": "papi-ai/ingest",
    "description": "Deterministic repository ingestion for PapiAI: render a codebase within a token budget",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Marcello Duarte",
            "email": "marcello.duarte@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "papi-ai/papi-core": "^0.14"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "vimeo/psalm": "^6.0"
    },
    "suggest": {
        "papi-ai/ingest-php-symbols": "Symbol extraction for PHP, required for Depth::Api",
        "papi-ai/ingest-gitingest": "Ingest remote repositories via the gitingest CLI"
    },
    "autoload": {
        "psr-4": {
            "PapiAI\\Ingest\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PapiAI\\Ingest\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "XDEBUG_MODE=coverage pest --coverage --min=60",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "lint:fix": "php-cs-fixer fix",
        "analyse": "psalm",
        "ci": ["@lint", "@analyse", "@test:coverage"]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
